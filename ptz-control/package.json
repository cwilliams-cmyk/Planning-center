{
  "name": "orz-control",
  "version": "2.0.0",
  "description": "OrZ Control - production PTZ camera control for Hollyland Astra (VISCA over IP) cameras",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "app": "electron .",
    "dist": "electron-builder --mac"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.ironoakchurch.astraptzcontrol",
    "productName": "OrZ Control",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "lib/**",
      "public/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ]
    }
  }
}
